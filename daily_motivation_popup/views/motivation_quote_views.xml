<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_motivation_quote_list" model="ir.ui.view">
        <field name="name">motivation.quote.list</field>
        <field name="model">motivation.quote</field>
        <field name="arch" type="xml">
            <list string="Motivation Quotes">
                <field name="text"/>
                <field name="author"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_motivation_quote_form" model="ir.ui.view">
        <field name="name">motivation.quote.form</field>
        <field name="model">motivation.quote</field>
        <field name="arch" type="xml">
            <form string="Motivation Quote">
                <sheet>
                    <group>
                        <field name="text"/>
                        <field name="author"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_motivation_quote" model="ir.actions.act_window">
        <field name="name">Motivation Quotes</field>
        <field name="res_model">motivation.quote</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first motivational quote!
            </p>
        </field>
    </record>

</odoo>
